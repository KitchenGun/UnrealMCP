# UnrealMCP environment variables — copy to `.env` and adjust as needed.
# Server reads these on startup; restart the MCP server to apply changes.

# ---------------------------------------------------------------------------
# Phase B — Response post-processing middleware
# ---------------------------------------------------------------------------

# How tool responses are post-processed before returning to the MCP client.
#   raw     — original JSON, no transformation (escape hatch / debugging)
#   compact — single-line JSON (~30% smaller than indented, no semantic loss)
#   summary — JSON + leading `_summary` field (default; raw payload preserved)
#   hermes  — full ResponseAdapter.to_hermes() (~70-90% smaller, intended for
#             orchestrator clients that only need a result_text)
UNREAL_MCP_RESPONSE_MODE=summary

# Comma-separated tool names to exclude from middleware wrapping. Useful if
# a specific tool's output must remain byte-identical to the C++ handler.
# Example: UNREAL_MCP_MIDDLEWARE_BYPASS=run_console_command,take_screenshot
UNREAL_MCP_MIDDLEWARE_BYPASS=

# ---------------------------------------------------------------------------
# Phase C — Safe Action Gate (always-on, even when RESPONSE_MODE=raw)
# ---------------------------------------------------------------------------

# Dry-run mode for destructive tools (delete_asset, delete_actor, run_console_command,
# load_level, play_in_editor, save_level). When true, those tools return a
# `{"_dry_run": true, "would_execute": ..., "params": ...}` report instead of
# executing. Truthy values: 1, true, yes, on (case-insensitive).
UNREAL_MCP_DRY_RUN=false

# Path to the run_console_command whitelist JSON. Relative paths resolve
# against the mcp-server package root. The file should contain:
#   {"prefixes": ["r.", "stat ", ...], "deny_prefixes": ["quit", "exit", ...]}
UNREAL_MCP_CONSOLE_WHITELIST=config/console_command_whitelist.json

# Comma-separated path prefixes that delete_asset must refuse. Engine and
# Script content are protected by default. Add custom prefixes if you need
# to protect a specific Game subdirectory.
# Example: /Engine/,/Script/,/Game/_Locked/
UNREAL_MCP_PROTECTED_PATHS=/Engine/,/Script/
